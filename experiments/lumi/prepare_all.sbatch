#!/usr/bin/env bash
#SBATCH --job-name=kev-all-source-data
#SBATCH --account=project_465002563
#SBATCH --partition=small
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=96G
#SBATCH --time=04:00:00
#SBATCH --chdir=/scratch/project_465002563/decision-models/kev-nesso2
#SBATCH --output=/scratch/project_465002563/decision-models/kev-nesso2/logs/prepare-all-%j.log
set -euo pipefail
source src/experiments/lumi/environment.sh
export SINGULARITYENV_HF_HUB_OFFLINE=1 SINGULARITYENV_HF_DATASETS_OFFLINE=1
srun --cpu-bind=none singularity exec -B /scratch/project_465002563:/scratch/project_465002563 \
  "$TASK_IMAGE" "$TASK_ROOT/env/bin/python" -u "$TASK_ROOT/src/experiments/lumi/prepare_full.py" \
  --out "$TASK_ROOT/runs/bilingual-all-v1" --prior "$TASK_ROOT/runs/bilingual-v2" \
  --all-source-rows --source-metadata "$TASK_ROOT/runs/bilingual-full-v1/english/manifest.json" "$@"
